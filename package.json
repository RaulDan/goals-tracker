{
	"name": "goals-tracker",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"start:mock-server": "node static-mock-server/server.js",
		"start-all-sv": "concurrently \"npm run serve:federation\" \"npm run start:mock-server\"",
		"build": "vite build",
		"build:federation": "webpack --config webpack.federation.cjs --mode production",
		"serve:federation": "webpack serve --config webpack.federation.cjs --mode development",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"webpack": "^5.112.2",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.2.2",
		"svelte-loader": "^3.2.4",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"concurrently": "^9.2.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
